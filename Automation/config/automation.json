{
  // automation：小艺自动化主流程配置。命令行参数优先级高于这里。
  "automation": {
    // 项目根目录。"." 表示当前仓库根目录，通常不用改。
    "project_root": ".",

    // HDC 可执行文件名或完整路径。hdc 已在 PATH 里时保持 "hdc"。
    "hdc": "hdc",

    // 默认设备 SN。null 表示自动使用唯一在线设备；真机填写真实 SN，模拟器可填写 "127.0.0.1:5555"。
    // 命令行 --sn 优先级高于这里。
    "sn": null,

    // DevEco SDK 和 JDK 路径，用于 ArkTS 编译签名。
    "deveco_sdk_home": "D:/devecostudio-windows-6.1.1.280/DevEco Studio/sdk",
    "java_home": "D:/devecostudio-windows-6.1.1.280/DevEco Studio/jbr",

    // 渲染工程目录。相对路径基于项目根目录；也可以填写绝对路径。
    "render_project_dir": "A2UI_Render_0716",

    // 渲染工程复制到 Automation/.work 后使用的目录名。null 表示自动使用渲染工程目录名。
    "render_work_dir_name": null,

    // 自动化把提取到的 DSL 写入渲染工程的哪个 rawfile。
    // 这个路径相对于渲染工程根目录，需要和页面代码里的 getRawFileContentSync(...) 保持一致。
    "rawfile_target": "entry/src/main/resources/rawfile/test.json",

    // HAP 构建输出目录，相对于渲染工程根目录。
    "hap_output_dir": "entry/build/default/outputs/default",

    // 自动化安装的 HAP 文件名。真机需要使用 signed HAP。
    "signed_hap_name": "entry-default-signed.hap",

    // hvigor 可执行文件。null 表示自动查找工程内 hvigorw 或系统 PATH。
    // 如果需要固定路径，可填写：
    // "D:/DevEco Studio/tools/hvigor/bin/hvigorw.bat"
    "hvigor_executable": "D:/devecostudio-windows-6.1.1.280/DevEco Studio/tools/hvigor/bin/hvigorw.bat",

    // HarmonyOS 应用启动信息，需要和渲染工程保持一致。
    "bundle_name": "com.example.myapplication",
    "ability_name": "EntryAbility",
    "module_name": "entry",

    // 等待小艺聊天界面可输入的最长秒数。
    "ready_timeout": 60,

    // 发送 query 后先等待多少秒，再开始滚动和提取 DSL。
    "post_query_wait": 30,

    // 单次 query 尝试提取 DSL 的最长秒数。
    "query_attempt_timeout": 90,

    // 单条 query 最多重试次数；失败后 batch 会跳过该 query 继续后续用例。
    // 注：batch/parallel 模式下每条 query 每轮只发送一次，重试由批次补发轮次承担。
    "query_max_attempts": 3,

    // 批次补发轮次：一轮结束后按 dsl/ 产物检查缺口，对仍缺 DSL 的 query 各补发一次，
    // 直到全部补齐或达到该上限；全部补齐后才进入渲染和规则评分流程。
    "batch_retry_rounds": 5,

    // DSL 获取来源：obs 表示从 hilog 中的 OBS 链接下载；ui 表示旧的 UI 树提取；auto 表示 OBS 失败后尝试 UI 树兜底。
    "dsl_source": "obs",

    // 发送 query 并清理 hilog 缓冲后，等待 OBS .md 链接出现的最长秒数。
    "obs_hilog_timeout": 400,

    // 下载 OBS .md 文件的 HTTP 超时时间，单位秒。
    "obs_download_timeout": 15,

    // OBS 下载到的 Markdown 原文保存目录。null 表示使用 output/obs_md；多设备并行时会使用 output/{safe_sn}/obs_md。
    "obs_markdown_dir": null,

    // 匹配到 OBS URL 时的 hilog 行保存目录。null 表示使用 output/obs_hilog；多设备并行时会使用 output/{safe_sn}/obs_hilog。
    "obs_hilog_match_dir": null,

    // ArkTS 构建最长秒数。
    "build_timeout": 300,

    // 启动渲染应用后等待画面稳定的秒数，再截图。
    "render_wait": 10,

    // 截图文件小于这个字节数会认为截图失败并重试。
    "screenshot_min_bytes": 1000,

    // 截图失败时最多重试次数。
    "screenshot_retries": 3,

    // 设备生成截图后等待写文件完成的秒数。
    "screenshot_write_wait": 1,

    // 是否在每条 query 的 DSL 保存成功后清理小艺上下文。
    "context_clear_enabled": false,

    // 清理上下文需要点击的屏幕绝对坐标，按顺序执行。
    // 示例：[{ "x": 980, "y": 180 }, { "x": 720, "y": 1320 }]
    "context_clear_points": [{ "x": 1150, "y": 255 }],

    // 每次清理点击后的等待秒数。
    "context_clear_wait": 1,

    // DSL 连续重试失败后，是否自动抓取一段设备 hilog 方便后续分析。
    // 只在某条 query 最终失败时触发，不会因为单次内部重试失败就抓日志。
    "hilog_on_dsl_failure": true,

    // 每次抓取 hilog 的秒数，默认 5 秒。日志太少可调大，文件太大可调小。
    "hilog_capture_seconds": 5,

    // hilog 输出目录。null 表示使用 output/logs；多设备并行时会使用 output/{safe_sn}/logs。
    // 也可以写成固定目录，例如 "output/logs"。
    "hilog_output_dir": null,

    // 是否在截图后自动裁切卡片图；开启规则评分或模型审美评分时也会自动裁切。
    "enable_card_crop": true,

    // 是否在裁切完成后执行本地纯规则美学评分。
    // 开启后输出到 output/reports，不调用任何外部模型。
    "enable_rule_check": true,

    // 卡片裁切配置文件路径，裁切位置变化时优先改这个文件。
    "card_crop_config": "Automation/config/card_crop.json",

    // 纯规则评分配置目录。null 表示使用 Aesthetic_Rule_Check/config。
    "rule_check_config_dir": null,

    // 是否输出卡片裁切调试图，方便看红框位置。
    "card_crop_debug": false,

    // 是否开启更详细日志。
    "debug": false
  },

  // aesthetics：审美评分配置。只有开启 enable 或传 --enable-aesthetics 时才会调用模型。
  "aesthetics": {
    // 是否默认开启审美评分。建议日常保持 false，需要时通过命令行开启。
    "enable": false,

    // 豆包/火山 Ark 接口地址。不要把密钥写进代码。
    "base_url": "",

    // API 密钥。推荐用环境变量 AESTHETICS_API_KEY，不建议提交真实密钥。
    "api_key": "",

    // 打分模型名称。
    "model": "doubao-seed-2-0-lite",

    // 输出模式：full 输出完整分析；score-only 只输出分数。
    "output_mode": "full",

    // 单次模型请求超时时间，单位秒。
    "timeout": 360,

    // 模型调用失败后的最大重试次数。
    "max_retries": 3,

    // 模型最多输出 token 数。
    "max_tokens": 1200,

    // 模型温度；0.0 更稳定。
    "temperature": 0.0,

    // 是否启用本地评分缓存。默认关闭，避免复用旧结果影响实验。
    "enable_cache": false,

    // 审美评分并发数。过大可能触发接口限流。
    "max_workers": 2,

    // true：某张图评分失败就终止；false：记录失败并继续。
    "fail_fast": false
  }
}
